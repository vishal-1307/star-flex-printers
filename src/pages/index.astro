---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import GraphicDesign from "../components/GraphicDesign.astro";
import TrustSection from "../components/TrustSection.astro";
import WhyUs from "../components/WhyUs.astro";
import Services from "../components/Services.astro";
import RecentWork from "../components/RecentWork.astro";
import Testimonials from "../components/Testimonials.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import StickyActionBar from "../components/StickyActionBar.astro";
import ServiceEnquiryDrawer from "../components/ServiceEnquiryDrawer.astro";
import Lightbox from "../components/Lightbox.astro";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <GraphicDesign />
    <TrustSection />
    <WhyUs />
    <Services limit={6} showViewAll />
    <RecentWork />
    <Testimonials />
    <CtaBand />
  </main>
  <Footer />
  <StickyActionBar />
  <ServiceEnquiryDrawer />
  <Lightbox />
</Layout>
