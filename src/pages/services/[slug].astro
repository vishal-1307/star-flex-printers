---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyActionBar from "../../components/StickyActionBar.astro";
import ServiceEnquiryDrawer from "../../components/ServiceEnquiryDrawer.astro";
import Lightbox from "../../components/Lightbox.astro";
import Icon from "../../components/Icon.astro";
import { services } from "../../data/services";
import { portfolio } from "../../data/portfolio";
import { site } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const samples = portfolio.filter((item) => item.service === service.name);
const relatedServices = service.related
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is (typeof services)[number] => Boolean(s));
---

<Layout
  title={`${service.name} — Star Flex Printers, Madhubani`}
  description={service.longDescription}
>
  <Header />
  <main>
    <section class="halftone border-b border-stone-200">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:py-16">
        <a href="/services" class="mb-4 inline-flex items-center gap-1 text-sm font-semibold text-brand hover:underline">
          ← All Services
        </a>
        <div class="reveal flex items-start gap-4">
          <div class="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-brand/10 text-brand">
            <Icon name={service.icon} class="h-7 w-7" />
          </div>
          <div>
            <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">{service.name}</h1>
            <p class="mt-1 text-ink/60">{service.blurb}</p>
          </div>
        </div>
        <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink/80">
          {service.longDescription}
        </p>

        <button
          type="button"
          class="reveal mt-8 inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg bg-wa px-6 text-base font-semibold text-white shadow-sm transition hover:bg-wa-dark"
          data-service-trigger
          data-service-name={service.name}
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          Get a Quote for {service.name}
        </button>
      </div>
    </section>

    {samples.length > 0 && (
      <section class="mx-auto max-w-4xl px-4 py-14 sm:py-16">
        <div class="reveal mb-8 max-w-xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Samples</p>
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
            Our <span class="marker">{service.name}</span> Work
          </h2>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          {samples.map((item) => (
            <button
              type="button"
              class="reveal cropmarks overflow-hidden rounded-lg border border-stone-200 bg-white text-left"
              data-lightbox-trigger
              data-lightbox-caption={item.caption}
              data-lightbox-service={item.service}
            >
              <Image
                src={item.image}
                alt={item.alt}
                class="aspect-square w-full object-cover"
                loading="lazy"
                widths={[240, 400, 600]}
                sizes="(min-width: 768px) 33vw, 50vw"
              />
            </button>
          ))}
        </div>
      </section>
    )}

    <section class="border-t border-stone-200 bg-white/50">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:py-16">
        <div class="reveal mb-8 max-w-xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">FAQ</p>
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
            Common <span class="marker">Questions</span>
          </h2>
        </div>
        <div class="space-y-4">
          {service.faqs.map((faq) => (
            <div class="reveal rounded-xl border border-stone-200 bg-paper p-5">
              <p class="font-semibold text-ink">{faq.q}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-ink/70">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {relatedServices.length > 0 && (
      <section class="mx-auto max-w-4xl px-4 py-14 sm:py-16">
        <div class="reveal mb-8 max-w-xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Related</p>
          <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
            You Might Also <span class="marker">Need</span>
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {relatedServices.map((rs) => (
            <a
              href={`/services/${rs.slug}`}
              class="reveal group rounded-xl border border-stone-200 bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <div class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand/10 text-brand">
                <Icon name={rs.icon} class="h-6 w-6" />
              </div>
              <h3 class="font-display text-base font-semibold leading-tight text-ink">{rs.name}</h3>
              <p class="mt-1 text-sm text-ink/60">{rs.blurb}</p>
              <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-brand/70 transition group-hover:text-brand">
                View Details →
              </p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
  <StickyActionBar />
  <ServiceEnquiryDrawer />
  <Lightbox />
</Layout>
