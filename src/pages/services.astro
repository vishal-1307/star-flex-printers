---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Services from "../components/Services.astro";
import Footer from "../components/Footer.astro";
import StickyActionBar from "../components/StickyActionBar.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Our Services — Star Flex Printers, Madhubani"
  description="Flex banners, hoarding boards, LED boards, visiting cards, wedding cards, letterheads and all digital, offset and screen printing services in Madhubani."
>
  <Header />
  <main>
    <section class="mx-auto max-w-6xl px-4 pt-10 sm:pt-14">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Our Services</p>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">
          Every Kind of <span class="marker">Printing</span>, One Place
        </h1>
        <a
          href="/brochure.pdf"
          download
          class="inline-flex items-center gap-2 rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold text-ink/80 transition hover:border-brand hover:text-brand"
        >
          <Icon name="download" class="h-4 w-4" />
          Download Brochure
        </a>
      </div>
      <p class="mt-3 max-w-xl text-ink/70">
        Tap a service below to send a quick query straight to WhatsApp.
      </p>
    </section>
    <Services showHeading={false} />
  </main>
  <Footer />
  <StickyActionBar />
</Layout>
