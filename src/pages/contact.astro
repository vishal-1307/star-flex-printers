---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import LocationSection from "../components/LocationSection.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
import StickyActionBar from "../components/StickyActionBar.astro";

const reasons = [
  { icon: "check", text: "Free, no-obligation quote" },
  { icon: "whatsapp", text: "Fast reply on WhatsApp" },
  { icon: "pencil", text: "Design help included" },
];
---

<Layout
  title="Contact Us — Star Flex Printers, Madhubani"
  description="Find Star Flex Printers at Bata Chowk, Madhubani, or send an enquiry — we reply on WhatsApp right away."
>
  <Header />
  <main>
    <section class="halftone border-b border-stone-200">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Get in Touch</p>
        <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">
          Contact <span class="marker">Star Flex Printers</span>
        </h1>
        <p class="mt-3 max-w-xl text-ink/70">
          Have a question or ready to order? Call, WhatsApp, or send an enquiry below — we always reply fast.
        </p>

        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          {reasons.map((r) => (
            <div class="flex items-center gap-2 text-sm font-medium text-ink/80">
              <Icon name={r.icon} class="h-4 w-4 text-brand" />
              {r.text}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
      <div class="grid gap-8 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <LocationSection showHeading={false} />
        </div>
        <div class="lg:col-span-3">
          <ContactForm showHeading={false} />
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <StickyActionBar />
</Layout>
