---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  extraJsonLd?: Record<string, unknown>[];
}

const defaultTitle =
  "Star Flex Printers — Flex Banner, LED Board & All Printing Services in Madhubani";
const defaultDescription =
  `Flex banner, hoarding, LED board, visiting cards, wedding cards and all printing services in Madhubani. ${site.address.line}. Call or WhatsApp: ${site.phones[0]}.`;

const { title = defaultTitle, description = defaultDescription, extraJsonLd = [] } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  alternateName: site.nameHindi,
  description: defaultDescription,
  email: site.email,
  telephone: `+91${site.phones[0]}`,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.line,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.pin,
    addressCountry: "IN",
  },
  openingHours: site.hours.schema,
  image: site.shopfront,
};

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.pathname} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site.shopfront} />
    <meta property="og:locale" content="en_IN" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraJsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <slot />
    <script>
      // Fade-up reveal on scroll
      const items = document.querySelectorAll(".reveal");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
