---
import { Image } from "astro:assets";
import { portfolio } from "../data/portfolio";

const featured = portfolio.filter((item) => item.featured);
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Recent Work</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        A Glimpse of Our <span class="marker">Work</span>
      </h2>
    </div>
    <a
      href="/gallery"
      class="inline-flex items-center gap-2 rounded-lg border border-brand px-6 py-2.5 text-sm font-semibold text-brand transition hover:bg-brand hover:text-white"
    >
      View Full Gallery
    </a>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-4">
    {featured.map((item) => (
      <div class="reveal cropmarks overflow-hidden rounded-lg border border-stone-200 bg-white">
        <Image
          src={item.image}
          alt={item.alt}
          class="aspect-square w-full object-cover"
          loading="lazy"
          widths={[240, 400]}
          sizes="(min-width: 768px) 25vw, 50vw"
        />
      </div>
    ))}
  </div>
</section>
