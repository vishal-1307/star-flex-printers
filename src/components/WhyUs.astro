---
import Icon from "./Icon.astro";
import { whyUs } from "../data/site";
---

<section id="why-us" class="border-y border-stone-200 bg-white/50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Why Us?</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Why <span class="marker">Choose</span> Star Flex Printers
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      {whyUs.map((item) => (
        <div class="reveal rounded-xl border border-stone-200 bg-paper p-6">
          <div class="mb-4 grid h-11 w-11 place-items-center rounded-lg bg-accent/20 text-brand">
            <Icon name={item.icon} class="h-6 w-6" />
          </div>
          <h3 class="font-display text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
