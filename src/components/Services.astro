---
import Icon from "./Icon.astro";
import { services } from "../data/site";
---

<section id="services" class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  <div class="reveal mb-10 max-w-xl">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">
      Our Services
    </p>
    <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
      Every Kind of <span class="marker">Printing</span>, One Place
    </h2>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
    {services.map((s, i) => (
      <div
        class="reveal group rounded-xl border border-stone-200 bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md"
        style={`transition-delay:${(i % 4) * 60}ms`}
      >
        <div class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand/10 text-brand">
          <Icon name={s.icon} class="h-6 w-6" />
        </div>
        <h3 class="font-display text-base font-semibold leading-tight text-ink">{s.name}</h3>
        <p class="mt-1 text-sm text-ink/60">{s.blurb}</p>
      </div>
    ))}
  </div>
</section>
