---
import ServiceCard from "./ServiceCard.astro";
import { services } from "../data/services";

interface Props {
  showHeading?: boolean;
  limit?: number;
  showViewAll?: boolean;
  enableQuery?: boolean;
}

const { showHeading = true, limit, showViewAll = false, enableQuery = false } = Astro.props;
const items = limit ? services.slice(0, limit) : services;
---

<section id="services" class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  {showHeading && (
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">
        Our Services
      </p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Every Kind of <span class="marker">Printing</span>, One Place
      </h2>
    </div>
  )}

  <div
    class:list={[
      "grid gap-4 sm:gap-5",
      enableQuery
        ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
        : "grid-cols-2 md:grid-cols-3 lg:grid-cols-4",
    ]}
  >
    {items.map((s, i) => (
      <ServiceCard
        name={s.name}
        icon={s.icon}
        blurb={s.blurb}
        index={i}
        enableQuery={enableQuery}
        transitionDelay={`${(i % 4) * 60}ms`}
      />
    ))}
  </div>

  {showViewAll && (
    <div class="reveal mt-8 text-center">
      <a
        href="/services"
        class="inline-flex items-center gap-2 rounded-lg border border-brand px-6 py-2.5 text-sm font-semibold text-brand transition hover:bg-brand hover:text-white"
      >
        View All Services
      </a>
    </div>
  )}
</section>

{enableQuery && (
  <script>
    import { site } from "../data/site";
    import { normalizePhone, isValidName, isValidPhone, buildWaUrl, openWa } from "../lib/whatsapp";

    const cards = document.querySelectorAll<HTMLElement>("[data-service-card]");

    const closeCard = (card: HTMLElement) => {
      card.querySelector("[data-service-panel]")?.classList.add("hidden");
      card.querySelector("[data-service-toggle]")?.setAttribute("aria-expanded", "false");
      card.querySelector("[data-service-chevron]")?.classList.remove("rotate-180");
    };

    cards.forEach((card) => {
      const toggle = card.querySelector<HTMLButtonElement>("[data-service-toggle]");
      const panel = card.querySelector<HTMLElement>("[data-service-panel]");
      const chevron = card.querySelector("[data-service-chevron]");

      toggle?.addEventListener("click", () => {
        const wasOpen = !panel?.classList.contains("hidden");
        cards.forEach((other) => {
          if (other !== card) closeCard(other);
        });
        panel?.classList.toggle("hidden", wasOpen);
        toggle.setAttribute("aria-expanded", String(!wasOpen));
        chevron?.classList.toggle("rotate-180", !wasOpen);
      });

      const form = card.querySelector<HTMLFormElement>("[data-service-form]");
      form?.addEventListener("submit", (e) => {
        e.preventDefault();

        const serviceName = form.dataset.serviceName ?? "";
        const nameEl = form.querySelector<HTMLInputElement>('[data-field="name"]')!;
        const phoneEl = form.querySelector<HTMLInputElement>('[data-field="phone"]')!;
        const noteEl = form.querySelector<HTMLTextAreaElement>('[data-field="note"]')!;
        const nameError = form.querySelector('[data-error="name"]');
        const phoneError = form.querySelector('[data-error="phone"]');

        const name = nameEl.value.trim();
        const phone = phoneEl.value.trim();
        const note = noteEl.value.trim();

        let valid = true;
        if (!isValidName(name)) {
          nameError?.classList.remove("hidden");
          valid = false;
        } else {
          nameError?.classList.add("hidden");
        }

        if (!isValidPhone(phone)) {
          phoneError?.classList.remove("hidden");
          valid = false;
        } else {
          phoneError?.classList.add("hidden");
        }

        if (!valid) return;

        let message = `Hi, I'm interested in ${serviceName}. Name: ${name}, Phone: ${normalizePhone(phone)}.`;
        if (note) message += ` ${note}`;

        openWa(buildWaUrl(site.whatsapp, [message]));
      });
    });
  </script>
)}
