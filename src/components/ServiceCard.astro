---
import Icon from "./Icon.astro";

interface Props {
  name: string;
  icon: string;
  blurb: string;
  index: number;
  enableQuery?: boolean;
  transitionDelay?: string;
}

const { name, icon, blurb, index, enableQuery = false, transitionDelay } = Astro.props;
const panelId = `svc-panel-${index}`;
---

<div
  class="reveal rounded-xl border border-stone-200 bg-white/60 transition hover:-translate-y-0.5 hover:shadow-md"
  style={transitionDelay ? `transition-delay:${transitionDelay}` : undefined}
  data-service-card
>
  {enableQuery ? (
    <button
      type="button"
      class="w-full p-5 text-left"
      aria-expanded="false"
      aria-controls={panelId}
      data-service-toggle
    >
      <div class="flex items-start justify-between gap-2">
        <div class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand/10 text-brand">
          <Icon name={icon} class="h-6 w-6" />
        </div>
        <Icon
          name="chevron"
          class="mt-1 h-5 w-5 shrink-0 text-ink/40 transition-transform duration-200"
          data-service-chevron
        />
      </div>
      <h3 class="font-display text-base font-semibold leading-tight text-ink">{name}</h3>
      <p class="mt-1 text-sm text-ink/60">{blurb}</p>
    </button>

    <div id={panelId} class="hidden border-t border-stone-200 px-5 pb-5 pt-4" data-service-panel>
      <form class="space-y-3" data-service-form data-service-name={name} novalidate>
        <div>
          <label class="mb-1 block text-xs font-medium text-ink">Name *</label>
          <input
            type="text"
            required
            data-field="name"
            class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
            placeholder="Your name"
          />
          <p class="mt-1 hidden text-xs text-brand" data-error="name">Please enter your name.</p>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-ink">Phone *</label>
          <input
            type="tel"
            inputmode="numeric"
            required
            data-field="phone"
            class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
            placeholder="10-digit mobile number"
          />
          <p class="mt-1 hidden text-xs text-brand" data-error="phone">Please enter a valid 10-digit number.</p>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-ink">Note (optional)</label>
          <textarea
            rows="2"
            data-field="note"
            class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
            placeholder="Size, quantity, urgency, etc."
          ></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex min-h-[40px] w-full items-center justify-center gap-2 rounded-lg bg-wa px-4 text-sm font-semibold text-white transition hover:bg-wa-dark"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          Send Query on WhatsApp
        </button>
      </form>
    </div>
  ) : (
    <div class="p-5">
      <div class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand/10 text-brand">
        <Icon name={icon} class="h-6 w-6" />
      </div>
      <h3 class="font-display text-base font-semibold leading-tight text-ink">{name}</h3>
      <p class="mt-1 text-sm text-ink/60">{blurb}</p>
    </div>
  )}
</div>
