---
import Icon from "./Icon.astro";

interface Props {
  name: string;
  slug?: string;
  icon: string;
  blurb: string;
  enableQuery?: boolean;
  transitionDelay?: string;
}

const { name, slug, icon, blurb, enableQuery = false, transitionDelay } = Astro.props;
---

{enableQuery ? (
  <div
    class="reveal overflow-hidden rounded-xl border border-stone-200 bg-white/60 transition hover:-translate-y-0.5 hover:shadow-md"
    style={transitionDelay ? `transition-delay:${transitionDelay}` : undefined}
  >
    <button
      type="button"
      class="group w-full p-5 text-left"
      data-service-trigger
      data-service-name={name}
    >
      <div class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand/10 text-brand">
        <Icon name={icon} class="h-6 w-6" />
      </div>
      <h3 class="font-display text-base font-semibold leading-tight text-ink">{name}</h3>
      <p class="mt-1 text-sm text-ink/60">{blurb}</p>
      <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-brand/70 transition group-hover:text-brand">
        Enquire on WhatsApp →
      </p>
    </button>
    {slug && (
      <a
        href={`/services/${slug}`}
        class="block border-t border-stone-200 px-5 py-3 text-xs font-semibold uppercase tracking-wide text-ink/50 transition hover:bg-stone-50 hover:text-brand"
      >
        View Details &amp; Samples →
      </a>
    )}
  </div>
) : (
  <div
    class="reveal rounded-xl border border-stone-200 bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md"
    style={transitionDelay ? `transition-delay:${transitionDelay}` : undefined}
  >
    <div class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand/10 text-brand">
      <Icon name={icon} class="h-6 w-6" />
    </div>
    <h3 class="font-display text-base font-semibold leading-tight text-ink">{name}</h3>
    <p class="mt-1 text-sm text-ink/60">{blurb}</p>
  </div>
)}
