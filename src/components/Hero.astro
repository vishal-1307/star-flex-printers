---
import Icon from "./Icon.astro";
import { site, telHref, waHref, waGreeting } from "../data/site";
---

<section id="top" class="halftone relative overflow-hidden border-b border-stone-200">
  <div class="hero-grid mx-auto max-w-6xl gap-10 px-4 py-16 sm:py-20 md:py-24">
    <div class="hero-top reveal">
      <p class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand">
        <span class="h-px w-6 bg-brand"></span>
        Madhubani's Own Printing Shop
      </p>
      <h1 class="font-display text-[clamp(2.2rem,8vw,4rem)] font-bold leading-[1.05] text-ink">
        Star Flex <span class="marker">Printers</span>
      </h1>
      <p class="mt-2 font-display text-xl text-ink/70">स्टार फ्लेक्स प्रिंटर्स</p>
      <p class="mt-5 max-w-md text-lg text-ink/80">{site.tagline}</p>
    </div>

    <div class="hero-photo reveal cropmarks mx-auto w-full max-w-md">
      <img
        src={site.shopfront}
        alt="Star Flex Printers shopfront at Bata Chowk, Madhubani"
        class="aspect-[3/4] w-full rounded-xl border border-stone-200 object-cover shadow-sm"
        width="1200"
        height="1600"
        loading="eager"
      />
    </div>

    <div class="hero-bottom reveal">
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={telHref(site.phones[0])}
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg bg-brand px-6 text-base font-semibold text-white shadow-sm transition hover:bg-brand-dark"
        >
          <Icon name="phone" class="h-5 w-5" />
          Call Now
        </a>
        <a
          href={waHref(waGreeting)}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg bg-wa px-6 text-base font-semibold text-white shadow-sm transition hover:bg-wa-dark"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          WhatsApp Now
        </a>
      </div>

      <p class="mt-5 text-sm text-ink/60">{site.hours.display}</p>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-areas: "top" "photo" "bottom";
  }
  .hero-top {
    grid-area: top;
  }
  .hero-photo {
    grid-area: photo;
  }
  .hero-bottom {
    grid-area: bottom;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "top photo" "bottom photo";
      align-items: center;
    }
  }
</style>
