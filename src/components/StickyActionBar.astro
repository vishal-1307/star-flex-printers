---
import Icon from "./Icon.astro";
import { site, telHref, waHref, waGreeting } from "../data/site";
---

<div
  id="sticky-bar"
  class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-stone-200 bg-white/95 backdrop-blur md:hidden"
>
  <div class="flex gap-2 p-3">
    <a
      href={telHref(site.phones[0])}
      class="inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-lg bg-brand text-sm font-semibold text-white"
    >
      <Icon name="phone" class="h-4 w-4" />
      Call Now
    </a>
    <a
      href={waHref(waGreeting)}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-lg bg-wa text-sm font-semibold text-white"
    >
      <Icon name="whatsapp" class="h-4 w-4" />
      WhatsApp
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById("sticky-bar");
  const SHOW_AFTER_PX = 320;

  if (bar) {
    const update = () => {
      bar.classList.toggle("hidden", window.scrollY < SHOW_AFTER_PX);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
