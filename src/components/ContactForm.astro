---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { services } from "../data/services";

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;
---

<div>
  {showHeading && (
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Get in Touch</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Place an Order or <span class="marker">Ask a Question</span>
      </h2>
    </div>
  )}

  <form id="enquiry-form" class="reveal space-y-4 rounded-xl border border-stone-200 bg-paper p-6 sm:p-8" novalidate>
    <div>
      <label for="name" class="mb-1 block text-sm font-medium text-ink">Name *</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
        placeholder="Your name"
      />
      <p class="mt-1 hidden text-xs text-brand" data-error="name">Please enter your name.</p>
    </div>

    <div>
      <label for="phone" class="mb-1 block text-sm font-medium text-ink">Phone Number *</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        inputmode="numeric"
        required
        class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
        placeholder="10-digit mobile number"
      />
      <p class="mt-1 hidden text-xs text-brand" data-error="phone">Please enter a valid 10-digit number.</p>
    </div>

    <div>
      <label for="service" class="mb-1 block text-sm font-medium text-ink">Service Needed</label>
      <select
        id="service"
        name="service"
        class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
      >
        <option value="">-- Select a service --</option>
        {services.map((s) => (
          <option value={s.name}>{s.name}</option>
        ))}
      </select>
      <p class="mt-1.5 text-xs text-ink/50">
        Can't find your service?{" "}
        <a href={`tel:+91${site.phones[0]}`} class="font-semibold text-brand hover:underline">Call us</a>{" "}
        or{" "}
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="font-semibold text-brand hover:underline">chat on WhatsApp</a>.
      </p>
    </div>

    <div>
      <label for="message" class="mb-1 block text-sm font-medium text-ink">Message (optional)</label>
      <textarea
        id="message"
        name="message"
        rows="3"
        class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
        placeholder="Anything else we should know?"
      ></textarea>
    </div>

    <button
      type="submit"
      class="inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-lg bg-wa px-6 text-base font-semibold text-white transition hover:bg-wa-dark sm:w-auto"
    >
      <Icon name="whatsapp" class="h-5 w-5" />
      Send on WhatsApp
    </button>

    <p class="hidden items-center gap-2 text-sm font-semibold text-wa-dark" data-form-success>
      <Icon name="check" class="h-4 w-4" />
      Opening WhatsApp with your message…
    </p>

    <p class="text-xs text-ink/50">
      Prefer email? Write to
      <a href={`mailto:${site.email}`} class="font-semibold text-brand hover:underline">{site.email}</a>.
    </p>
  </form>
</div>

<script>
  import { site } from "../data/site";
  import { normalizePhone, isValidName, isValidPhone, buildWaUrl, openWa } from "../lib/whatsapp";

  const form = document.getElementById("enquiry-form") as HTMLFormElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const nameEl = document.getElementById("name") as HTMLInputElement;
    const phoneEl = document.getElementById("phone") as HTMLInputElement;
    const serviceEl = document.getElementById("service") as HTMLSelectElement;
    const messageEl = document.getElementById("message") as HTMLTextAreaElement;
    const successEl = form.querySelector<HTMLElement>("[data-form-success]");

    const name = nameEl.value.trim();
    const phone = phoneEl.value.trim();
    const service = serviceEl.value;
    const message = messageEl.value.trim();

    const nameError = document.querySelector('[data-error="name"]');
    const phoneError = document.querySelector('[data-error="phone"]');

    let valid = true;
    if (!isValidName(name)) {
      nameError?.classList.remove("hidden");
      valid = false;
    } else {
      nameError?.classList.add("hidden");
    }

    if (!isValidPhone(phone)) {
      phoneError?.classList.remove("hidden");
      valid = false;
    } else {
      phoneError?.classList.add("hidden");
    }

    if (!valid) {
      successEl?.classList.add("hidden");
      successEl?.classList.remove("flex");
      return;
    }

    const lines = [
      "Hello Star Flex Printers!",
      `Name: ${name}`,
      `Phone: ${normalizePhone(phone)}`,
    ];
    if (service) lines.push(`Service: ${service}`);
    if (message) lines.push(`Message: ${message}`);

    openWa(buildWaUrl(site.whatsapp, lines));

    successEl?.classList.remove("hidden");
    successEl?.classList.add("flex");
    window.setTimeout(() => {
      successEl?.classList.add("hidden");
      successEl?.classList.remove("flex");
    }, 4000);
  });
</script>
