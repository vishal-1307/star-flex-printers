---
import Icon from "./Icon.astro";
import { site, telHref, services } from "../data/site";
---

<section id="contact" class="border-t border-stone-200 bg-white/50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Get in Touch</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Place an Order or <span class="marker">Ask a Question</span>
      </h2>
      <p class="mt-3 text-ink/70">
        Fill the form and we'll get your message straight on WhatsApp — or just call/WhatsApp us directly.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-5">
      <form id="enquiry-form" class="reveal md:col-span-3 space-y-4 rounded-xl border border-stone-200 bg-paper p-6 sm:p-8" novalidate>
        <div>
          <label for="name" class="mb-1 block text-sm font-medium text-ink">Name *</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
            placeholder="Your name"
          />
          <p class="mt-1 hidden text-xs text-brand" data-error="name">Please enter your name.</p>
        </div>

        <div>
          <label for="phone" class="mb-1 block text-sm font-medium text-ink">Phone Number *</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            inputmode="numeric"
            required
            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
            placeholder="10-digit mobile number"
          />
          <p class="mt-1 hidden text-xs text-brand" data-error="phone">Please enter a valid 10-digit number.</p>
        </div>

        <div>
          <label for="service" class="mb-1 block text-sm font-medium text-ink">Service Needed</label>
          <select
            id="service"
            name="service"
            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
          >
            <option value="">-- Select a service --</option>
            {services.map((s) => (
              <option value={s.name}>{s.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="mb-1 block text-sm font-medium text-ink">Message (optional)</label>
          <textarea
            id="message"
            name="message"
            rows="3"
            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"
            placeholder="Anything else we should know?"
          ></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-lg bg-wa px-6 text-base font-semibold text-white transition hover:bg-wa-dark sm:w-auto"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          Send on WhatsApp
        </button>
      </form>

      <div class="reveal md:col-span-2 flex flex-col gap-4 rounded-xl border border-stone-200 bg-paper p-6 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-ink/50">Don't Want to Fill a Form?</p>
        <p class="text-ink/70">Call or WhatsApp us directly — we'll respond right away.</p>

        <a
          href={telHref(site.phones[0])}
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg bg-brand px-6 text-base font-semibold text-white transition hover:bg-brand-dark"
        >
          <Icon name="phone" class="h-5 w-5" />
          Call Now
        </a>
        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg bg-wa px-6 text-base font-semibold text-white transition hover:bg-wa-dark"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          WhatsApp Now
        </a>

        <div class="mt-2 space-y-1 border-t border-stone-200 pt-4 text-sm text-ink/70">
          {site.phones.map((p) => (
            <a href={telHref(p)} class="block hover:text-brand">{p}</a>
          ))}
          <a href={`mailto:${site.email}`} class="block hover:text-brand">{site.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumber: site.whatsapp }}>
  const form = document.getElementById("enquiry-form");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const nameEl = document.getElementById("name");
    const phoneEl = document.getElementById("phone");
    const serviceEl = document.getElementById("service");
    const messageEl = document.getElementById("message");

    const name = nameEl.value.trim();
    const phone = phoneEl.value.trim();
    const service = serviceEl.value;
    const message = messageEl.value.trim();

    const phoneDigits = phone.replace(/\D/g, "");
    const nameError = document.querySelector('[data-error="name"]');
    const phoneError = document.querySelector('[data-error="phone"]');

    let valid = true;
    if (name.length < 2) {
      nameError?.classList.remove("hidden");
      valid = false;
    } else {
      nameError?.classList.add("hidden");
    }

    if (phoneDigits.length !== 10) {
      phoneError?.classList.remove("hidden");
      valid = false;
    } else {
      phoneError?.classList.add("hidden");
    }

    if (!valid) return;

    const lines = [
      "Hello Star Flex Printers!",
      `Name: ${name}`,
      `Phone: ${phoneDigits}`,
    ];
    if (service) lines.push(`Service: ${service}`);
    if (message) lines.push(`Message: ${message}`);

    const text = encodeURIComponent(lines.join("\n"));
    window.open(`https://wa.me/${whatsappNumber}?text=${text}`, "_blank", "noopener");
  });
</script>
