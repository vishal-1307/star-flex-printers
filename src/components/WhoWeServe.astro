---
import Icon from "./Icon.astro";
import { categories } from "../data/categories";
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  <div class="reveal mb-10 max-w-xl">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Who We Serve</p>
    <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
      Printing for <span class="marker">Every Kind</span> of Customer
    </h2>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
    {categories.map((c, i) => (
      <a
        href={`/for/${c.slug}`}
        class="reveal group rounded-xl border border-stone-200 bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-md"
        style={`transition-delay:${(i % 4) * 60}ms`}
      >
        <div class="mb-3 grid h-11 w-11 place-items-center rounded-lg bg-brand/10 text-brand">
          <Icon name={c.icon} class="h-6 w-6" />
        </div>
        <h3 class="font-display text-base font-semibold leading-tight text-ink">{c.label}</h3>
        <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-brand/70 transition group-hover:text-brand">
          See Services →
        </p>
      </a>
    ))}
  </div>
</section>
