  class?: string;
}
const { name, class: className = "" } = Astro.props;

const paths: Record<string, string> = {
  phone:
    "M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z",
  whatsapp:
    "M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm4.9 12.7c-.2.6-1.2 1.1-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.4-3.9-4.6-4.1-.1-.2-1.1-1.4-1.1-2.7s.7-1.9 1-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.2.3-.3.5-.2.2-.3.3-.5.5-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.5 1.5.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.8.8.3.1.5.2.5.3.1.2.1.6-.1 1.2Z",
  banner: "M3 6h18v9c-3-1.3-6-1.3-9 0s-6 1.3-9 0V6Zm2 12h14",
  hoarding: "M4 6h16v9H4zM8 15v5m8-5v5M6 20h12",
  led: "M9 3h6l1 6-3 3v3h-2v-3l-3-3 1-6ZM10 18h4v3h-4z",
  light: "M4 7h16v9H4zM7 20h10M9 11h6M9 14h4",
  letter3d: "M6 19V9l6-6 6 6v10h-4v-6H10v6H6Z",
  acp: "M4 5h11v6H4zM9 13h11v6H9z",
  card: "M3 6h18v12H3zM7 15h4M15 10.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z",
  idcard:
    "M4 4h16v16H4zM12 8a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm-4 9c.5-2.5 2.2-4 4-4s3.5 1.5 4 4",
  wedding:
    "M12 21s-7-4.4-9.3-8.6C1.3 9.5 3 6.5 6 6.5c1.7 0 3 .9 4 2.3.9-1.4 2.3-2.3 4-2.3 3 0 4.7 3 3.3 5.9C19 16.6 12 21 12 21Z",
  letterhead: "M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2V3Zm3 5h8m-8 4h8m-8 4h5",
  press:
    "M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2M6 14h12v7H6v-7Z",
  sticker: "M6 3h9l6 6v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm9 0v6h6",
  roof: "M4 11 12 4l8 7v9H4v-9Zm5 9v-6h6v6",
  discount: "M4 13.3 13.3 4H19a1 1 0 0 1 1 1v5.7L10.7 20 4 13.3Z",
  mail: "M4 5h16v14H4zM4 6l8 7 8-7",
  pin: "M12 21s7-6.6 7-11.5A7 7 0 0 0 5 9.5C5 14.4 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
  menu: "M3 6h18M3 12h18M3 18h18",
  close: "M6 6l12 12M18 6 6 18",
  compass: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm2.5 6.5-1.5 4-4 1.5 1.5-4 4-1.5Z",
