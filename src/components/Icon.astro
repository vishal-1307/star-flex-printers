  chevron: "M6 9l6 6 6-6",
};

// phone/whatsapp are solid glyph shapes — must be filled, not stroked,
// or the silhouette renders as a hollow/scribbled outline.
const FILLED = new Set(["phone", "whatsapp"]);

const d = paths[name] ?? paths.phone;
const isFilled = FILLED.has(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
