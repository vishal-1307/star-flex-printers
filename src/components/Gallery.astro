---
import { Image } from "astro:assets";
import { portfolio } from "../data/portfolio";

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;
const uniqueServices = [...new Set(portfolio.map((item) => item.service))];
---

<section id="gallery" class="halftone mx-auto max-w-6xl px-4 py-16 sm:py-20">
  {showHeading && (
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Our Work</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        A Look at Our <span class="marker">Work</span>
      </h2>
      <p class="mt-3 text-ink/70">
        Real work done at Star Flex Printers — banners, boards, cards and more. Tap any photo to view it larger.
      </p>
    </div>
  )}

  <div class="reveal mb-6 flex flex-wrap gap-2">
    <button
      type="button"
      class="filter-chip rounded-full border border-brand bg-brand px-4 py-1.5 text-xs font-semibold text-white"
      data-filter-chip
      data-filter-value="all"
    >
      All
    </button>
    {uniqueServices.map((service) => (
      <button
        type="button"
        class="filter-chip rounded-full border border-stone-300 px-4 py-1.5 text-xs font-semibold text-ink/70 transition hover:border-brand hover:text-brand"
        data-filter-chip
        data-filter-value={service}
      >
        {service}
      </button>
    ))}
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4" data-gallery-grid>
    {portfolio.map((item) => (
      <button
        type="button"
        class="reveal cropmarks overflow-hidden rounded-lg border border-stone-200 bg-white text-left"
        data-lightbox-trigger
        data-lightbox-caption={item.caption}
        data-lightbox-service={item.service}
      >
        <Image
          src={item.image}
          alt={item.alt}
          class="aspect-square w-full object-cover"
          loading="lazy"
          widths={[240, 400, 600, 900]}
          sizes="(min-width: 768px) 25vw, 50vw"
        />
      </button>
    ))}
  </div>
</section>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-filter-chip]");
  const items = document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const value = chip.dataset.filterValue;

      chips.forEach((c) => {
        const active = c === chip;
        c.classList.toggle("bg-brand", active);
        c.classList.toggle("border-brand", active);
        c.classList.toggle("text-white", active);
        c.classList.toggle("border-stone-300", !active);
        c.classList.toggle("text-ink/70", !active);
      });

      items.forEach((item) => {
        const match = value === "all" || item.dataset.lightboxService === value;
        item.classList.toggle("hidden", !match);
      });
    });
  });
</script>
