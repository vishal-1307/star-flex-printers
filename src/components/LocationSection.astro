---
import Icon from "./Icon.astro";
import { site, telHref } from "../data/site";

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;
---

<div>
  {showHeading && (
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Find Us</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Our <span class="marker">Location</span>
      </h2>
    </div>
  )}

  <div class="space-y-5">
    <div class="reveal overflow-hidden rounded-xl border border-stone-200">
      <iframe
        title="Star Flex Printers — Google Maps location"
        src={site.mapsEmbed}
        class="h-64 w-full"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="reveal space-y-4 rounded-xl border border-stone-200 bg-white/60 p-6">
      <div class="flex gap-3">
        <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
        <div>
          <p class="font-semibold text-ink">{site.address.line}</p>
          <p class="text-ink/70">
            {site.address.city}, {site.address.state} {site.address.pin}
          </p>
        </div>
      </div>

      <div class="flex gap-3">
        <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
        <p class="text-ink/80">{site.hours.display}</p>
      </div>

      <div class="flex flex-col gap-3 pt-1 sm:flex-row">
        <a
          href={telHref(site.phones[0])}
          class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg bg-brand px-4 text-sm font-semibold text-white transition hover:bg-brand-dark"
        >
          <Icon name="phone" class="h-4 w-4" />
          Call Now
        </a>
        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg bg-wa px-4 text-sm font-semibold text-white transition hover:bg-wa-dark"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          WhatsApp
        </a>
      </div>

      <a
        href={site.mapsDirections}
        target="_blank"
        rel="noopener"
        class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-brand hover:underline"
      >
        <Icon name="compass" class="h-4 w-4" />
        Get Directions
      </a>
    </div>
  </div>
</div>
