---
import Icon from "./Icon.astro";
---

<div class="lightbox-backdrop pointer-events-none fixed inset-0 z-[80] hidden bg-ink/90" data-lightbox-backdrop></div>

<div
  class="lightbox pointer-events-none fixed inset-0 z-[90] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Image preview"
  data-lightbox
>
  <button
    type="button"
    class="absolute right-4 top-4 z-10 grid h-10 w-10 place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
    aria-label="Close"
    data-lightbox-close
  >
    <Icon name="close" class="h-5 w-5" />
  </button>
  <button
    type="button"
    class="absolute left-2 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:left-4"
    aria-label="Previous image"
    data-lightbox-prev
  >
    <Icon name="arrow" class="h-5 w-5 rotate-180" />
  </button>
  <button
    type="button"
    class="absolute right-2 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:right-4"
    aria-label="Next image"
    data-lightbox-next
  >
    <Icon name="arrow" class="h-5 w-5" />
  </button>

  <div class="flex h-full flex-col items-center justify-center gap-4 p-4 sm:p-10">
    <img data-lightbox-image class="max-h-[65vh] max-w-full rounded-lg object-contain shadow-2xl" alt="" />
    <div class="max-w-md text-center">
      <p data-lightbox-caption-display class="font-semibold text-white"></p>
      <a
        data-lightbox-cta
        href="#"
        target="_blank"
        rel="noopener"
        class="mt-3 inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-wa px-5 text-sm font-semibold text-white transition hover:bg-wa-dark"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Get a Similar Design
      </a>
    </div>
  </div>
</div>

<script>
  import { site } from "../data/site";
  import { buildWaUrl, openWa } from "../lib/whatsapp";

  const backdrop = document.querySelector<HTMLElement>("[data-lightbox-backdrop]");
  const box = document.querySelector<HTMLElement>("[data-lightbox]");
  const imgEl = document.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const captionEl = document.querySelector<HTMLElement>("[data-lightbox-caption-display]");
  const ctaEl = document.querySelector<HTMLAnchorElement>("[data-lightbox-cta]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-lightbox-close]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-lightbox-next]");

  if (backdrop && box && imgEl && captionEl && ctaEl) {
    const triggers = Array.from(document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]"));
    let currentIndex = -1;

    const bestSrc = (trigger: HTMLElement): { src: string; alt: string } => {
      const img = trigger.querySelector("img");
      const srcset = img?.getAttribute("srcset");
      if (!srcset) return { src: img?.src ?? "", alt: img?.alt ?? "" };
      const entries = srcset
        .split(",")
        .map((s) => s.trim().split(" "))
        .map(([url, w]) => [url, parseInt(w)] as [string, number]);
      entries.sort((a, b) => a[1] - b[1]);
      return { src: entries[entries.length - 1][0], alt: img?.alt ?? "" };
    };

    const visibleTriggers = () => triggers.filter((t) => !t.classList.contains("hidden"));

    const show = (index: number) => {
      const visible = visibleTriggers();
      if (visible.length === 0) return;
      currentIndex = ((index % visible.length) + visible.length) % visible.length;
      const trigger = visible[currentIndex];
      const { src, alt } = bestSrc(trigger);
      imgEl.src = src;
      imgEl.alt = alt;
      const caption = trigger.dataset.lightboxCaption ?? "";
      const service = trigger.dataset.lightboxService ?? "";
      captionEl.textContent = caption;
      const message = `Hi, I saw "${caption}" in your gallery and I'd like something similar${service ? ` (${service})` : ""}.`;
      ctaEl.href = buildWaUrl(site.whatsapp, [message]);
    };

    const open = (trigger: HTMLElement) => {
      const visible = visibleTriggers();
      const idx = visible.indexOf(trigger);
      backdrop.classList.remove("hidden", "pointer-events-none");
      box.classList.remove("hidden", "pointer-events-none");
      requestAnimationFrame(() => {
        backdrop.classList.add("is-open");
        box.classList.add("is-open");
      });
      document.body.style.overflow = "hidden";
      show(idx);
    };

    const close = () => {
      backdrop.classList.remove("is-open");
      box.classList.remove("is-open");
      backdrop.classList.add("pointer-events-none");
      box.classList.add("pointer-events-none");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        backdrop.classList.add("hidden");
        box.classList.add("hidden");
      }, 300);
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => open(trigger));
    });

    closeBtn?.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => show(currentIndex - 1));
    nextBtn?.addEventListener("click", () => show(currentIndex + 1));

    document.addEventListener("keydown", (e) => {
      if (box.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(currentIndex - 1);
      if (e.key === "ArrowRight") show(currentIndex + 1);
    });

    let touchStartX = 0;
    box.addEventListener("touchstart", (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    box.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 50) {
        show(currentIndex + (dx > 0 ? -1 : 1));
      }
    }, { passive: true });
  }
</script>
