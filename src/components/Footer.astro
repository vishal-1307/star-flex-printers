---
import Icon from "./Icon.astro";
import { site, telHref } from "../data/site";
---

<footer class="bg-ink text-paper/80">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <img src={site.logo} alt="Star Flex Printers logo" class="h-12 w-auto rounded bg-paper p-1" />
        <p class="mt-3 font-display text-base text-paper/60">{site.nameHindi}</p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/60">{site.tagline}</p>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent">Contact</p>
        <ul class="space-y-2 text-sm">
          {site.phones.map((p) => (
            <li>
              <a href={telHref(p)} class="inline-flex items-center gap-2 hover:text-white">
                <Icon name="phone" class="h-4 w-4" />
                {p}
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-white">
              <Icon name="mail" class="h-4 w-4" />
              {site.email}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent">Address &amp; Hours</p>
        <p class="flex items-start gap-2 text-sm">
          <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0" />
          <span>
            {site.address.line}, {site.address.city}, {site.address.state} {site.address.pin}
          </span>
        </p>
        <p class="mt-3 text-sm text-paper/60">{site.hours.short}</p>

        <div class="mt-5 flex gap-3">
          <a href="#" aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-full border border-paper/20 text-paper/60 transition hover:border-white hover:text-white">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M13 22v-8h3l.5-3.5H13V8.3c0-1 .3-1.8 1.8-1.8H17V3.2C16.5 3.1 15.3 3 14 3c-2.9 0-4.7 1.7-4.7 4.9V10.5H6V14h3.3v8Z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full border border-paper/20 text-paper/60 transition hover:border-white hover:text-white">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-paper/10 pt-6 text-xs text-paper/40">
      &copy; {new Date().getFullYear()} Star Flex Printers. All rights reserved.
    </div>
  </div>
</footer>
