---
import ServiceCard from "./ServiceCard.astro";
import { designServices } from "../data/designServices";
---

<section id="graphic-design" class="border-y border-stone-200 bg-white/50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Graphic Design</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Need a <span class="marker">Design</span>? We've Got You
      </h2>
      <p class="mt-3 text-ink/70">
        No ready artwork? Our in-house designers can create it for you — just tell us what you need.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
      {designServices.map((s, i) => (
        <ServiceCard
          name={s.name}
          icon={s.icon}
          blurb={s.blurb}
          enableQuery
          transitionDelay={`${(i % 4) * 60}ms`}
        />
      ))}
    </div>
  </div>
</section>
