---
import { testimonials } from "../data/site";
---

<section id="testimonials" class="border-y border-stone-200 bg-white/50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">Grahak Kya Kehte Hain</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Log Hume <span class="marker">Pasand</span> Karte Hain
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      {testimonials.map((quote) => (
        <figure class="reveal rounded-xl border border-stone-200 bg-paper p-6">
          <svg viewBox="0 0 24 24" class="mb-3 h-7 w-7 text-accent" fill="currentColor" aria-hidden="true">
            <path d="M9 7c-2.8 0-5 2.2-5 5v5h5v-5H6.5C6.5 9.8 7.6 8.6 9 8.3V7Zm10 0c-2.8 0-5 2.2-5 5v5h5v-5h-2.5c0-2.2 1.1-3.4 2.5-3.7V7Z" />
          </svg>
          <blockquote class="text-sm leading-relaxed text-ink/80">{quote}</blockquote>
          <figcaption class="mt-4 text-xs font-semibold uppercase tracking-wide text-ink/50">
            Google Review
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
