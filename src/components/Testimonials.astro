---
import Icon from "./Icon.astro";
import { testimonials } from "../data/site";
---

<section id="testimonials" class="border-y border-stone-200 bg-white/50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="reveal mb-10 max-w-xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">What Customers Say</p>
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        People <span class="marker">Love</span> Working With Us
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="reveal rounded-xl border border-stone-200 bg-paper p-6">
          <div class="mb-3 flex gap-0.5 text-accent" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: t.rating }).map(() => (
              <Icon name="star" class="h-4 w-4" />
            ))}
          </div>
          <blockquote class="text-sm leading-relaxed text-ink/80">{t.quote}</blockquote>
          <figcaption class="mt-4">
            <p class="text-sm font-semibold text-ink">{t.name}</p>
            <p class="text-xs font-semibold uppercase tracking-wide text-ink/50">Google Review</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
