---
import Icon from "./Icon.astro";
import { site, telHref, waHref, waGreeting } from "../data/site";
---

<section class="border-t border-stone-200 bg-ink">
  <div class="reveal mx-auto max-w-6xl px-4 py-14 text-center sm:py-16">
    <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
      Ready to get your printing done?
    </h2>
    <p class="mt-3 text-paper/60">
      Call, WhatsApp, or reach out through our contact page — we respond right away.
    </p>

    <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={telHref(site.phones[0])}
        class="inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-lg bg-brand px-6 text-base font-semibold text-white shadow-sm transition hover:bg-brand-dark sm:w-auto"
      >
        <Icon name="phone" class="h-5 w-5" />
        Call Now
      </a>
      <a
        href={waHref(waGreeting)}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-lg bg-wa px-6 text-base font-semibold text-white shadow-sm transition hover:bg-wa-dark sm:w-auto"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        WhatsApp Now
      </a>
      <a
        href="/contact"
        class="inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-lg border border-paper/30 px-6 text-base font-semibold text-white transition hover:border-white sm:w-auto"
      >
        Contact Us
      </a>
    </div>
  </div>
</section>
